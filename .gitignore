# dependencies
node_modules/

# build output (regenerated by `node tools/build.mjs`; CI builds and deploys it)
dist/
play/
dev.html

# large, reproducible tool artefacts (see tools/music/.gitignore too)
tools/sfx/downloads/
tools/music/downloads/
tools/music/out/

# local dev server / runtime state
.serve.pid
*.pid
*.lock

# logs, scratch and temp files
*.log
npm-debug.log*
*.tmp
*.temp
*.bak
*.swp
*~
tmp/
scratch/
.DS_Store
Thumbs.db

# secrets (the TTS tool reads GEMINI_API_KEY from the environment only)
.env
.env.*

# TTS masters for the AWACS clips (regenerate with tools/gen_awacs_tts.mjs; the trimmed clips in assets/awacs/ ship)
assets/awacs/raw/
assets/dialogue/raw/

# local-only notes and agent prompts
SPEC.md
SPEC_PHASE2.md

# voice audition candidates (local listening only; not shipped)
assets/voice_audition/
DIALOGUE_NOTES.md
DIALOGUE_DRAFT.md
LORE.md

# music audition renders (local listening only; regenerate with tools/music/render_mainspring.mjs, render_night.mjs, crossfade_test.mjs)
assets/music_audition/
